# Monolithic Open5GS 5GC config — consumed by the `5gc` test binary in
# skillful-ran/open5gs:v2.7.0, which runs every NF in-process. SCP routing
# is internal (all NFs on 127.0.0.x); only the AMF NGAP and UPF GTPU bind
# to the external docker network IP so the gNB+UE can reach them.
#
# Architecture in the container:
#   nrf  127.0.0.10:7777
#   ausf 127.0.0.11:7777
#   udm  127.0.0.12:7777
#   pcf  127.0.0.13:7777
#   nssf 127.0.0.14:7777
#   bsf  127.0.0.15:7777
#   udr  127.0.0.20:7777
#   scp  127.0.0.22:7777   ← all NFs' SBI client points here
#   smf  127.0.0.4:7777    (+ PFCP/GTPC/GTPU on 127.0.0.4)
#   amf  127.0.0.5:7777    (+ NGAP on 10.53.1.2:38412)
#   upf  127.0.0.7         (PFCP) + 10.53.1.2:2152 (GTP-U)
#
# 4G NFs (mme/sgwc/sgwu/hss/pcrf) are disabled via global.parameter so
# this is a pure 5G SA core.

db_uri: mongodb://${MONGODB_IP}/open5gs

logger:
  level: info

test:
  serving:
    - plmn_id:
        mcc: 001
        mnc: 01

global:
  parameter:
    no_ipv6: true
    no_sepp: true
    no_mme: true
    no_sgwc: true
    no_sgwu: true
    no_pcrf: true
    no_hss: true

smf:
  sbi:
    server:
      - address: 127.0.0.4
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777
  pfcp:
    server:
      - address: 127.0.0.4
    client:
      upf:
        - address: 127.0.0.7
  gtpc:
    server:
      - address: 127.0.0.4
  gtpu:
    server:
      - address: 127.0.0.4
  metrics:
    server:
      - address: 127.0.0.4
        port: 9090
  session:
    - subnet: ${UE_IP_RANGE}
      gateway: ${UE_GATEWAY_IP}
  dns:
    - 8.8.8.8
    - 1.1.1.1
  mtu: 1400
  info:
    - s_nssai:
        - sst: 1
          dnn:
            - srsapn

amf:
  sbi:
    server:
      - address: 127.0.0.5
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777
  ngap:
    server:
      - address: ${OPEN5GS_IP}
  guami:
    - plmn_id:
        mcc: 001
        mnc: 01
      amf_id:
        region: 2
        set: 1
  tai:
    - plmn_id:
        mcc: 001
        mnc: 01
      tac: 1
  plmn_support:
    - plmn_id:
        mcc: 001
        mnc: 01
      s_nssai:
        - sst: 1
  security:
    integrity_order: [NIA2, NIA1, NIA0]
    ciphering_order: [NEA0, NEA1, NEA2]
  network_name:
    full: Open5GS
    short: Next
  amf_name: open5gs-amf0
  time:
    t3512:
      value: 540

upf:
  pfcp:
    server:
      - address: 127.0.0.7
  gtpu:
    server:
      - address: ${OPEN5GS_IP}
        advertise: ${UPF_ADVERTISE_IP}
  session:
    - subnet: ${UE_IP_RANGE}
      gateway: ${UE_GATEWAY_IP}

nrf:
  sbi:
    server:
      - address: 127.0.0.10
        port: 7777
  serving:
    - plmn_id:
        mcc: 001
        mnc: 01

scp:
  sbi:
    server:
      - address: 127.0.0.22
        port: 7777
    client:
      nrf:
        - uri: http://127.0.0.10:7777

ausf:
  sbi:
    server:
      - address: 127.0.0.11
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777

udm:
  hnet:
    - id: 1
      scheme: 1
      key: /opt/open5gs/etc/open5gs/hnet/curve25519-1.key
    - id: 2
      scheme: 2
      key: /opt/open5gs/etc/open5gs/hnet/secp256r1-2.key
  sbi:
    server:
      - address: 127.0.0.12
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777

pcf:
  sbi:
    server:
      - address: 127.0.0.13
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777

nssf:
  sbi:
    server:
      - address: 127.0.0.14
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777
      nsi:
        - uri: http://127.0.0.10:7777
          s_nssai:
            sst: 1

bsf:
  sbi:
    server:
      - address: 127.0.0.15
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777

udr:
  sbi:
    server:
      - address: 127.0.0.20
        port: 7777
    client:
      scp:
        - uri: http://127.0.0.22:7777
