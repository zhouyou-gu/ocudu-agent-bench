{
  "version": 1,
  "description": "Benchmark action catalog for local validation before dispatch to OCUDU runtime interfaces.",
  "actions": [
    {
      "type": "STUB_NOOP",
      "stub": true,
      "description": "Only accepted action in the v1 skeleton. Runtime OCUDU actions are added in later stages."
    },
    {
      "type": "SET_PRB_POLICY_RATIO_WS",
      "stage": "v3",
      "tasks": [
        "ws_prb_ping_v1",
        "e2_kpm_prb_ping_v1"
      ],
      "description": "WebSocket PRB policy action used by both current scored tasks. Min/max ratios are scored; dedicated ratio is validity-only.",
      "required_fields": [
        "min_prb_policy_ratio",
        "max_prb_policy_ratio"
      ],
      "defaults": {
        "plmn": "00101",
        "sst": 1,
        "sd": null,
        "dedicated_ratio": null
      },
      "constraints": {
        "min_prb_policy_ratio": "integer in [0, 100]",
        "max_prb_policy_ratio": "integer in [0, 100]",
        "ordering": "min_prb_policy_ratio <= max_prb_policy_ratio"
      },
      "wire_command": "rrm_policy_ratio_set"
    },
    {
      "type": "SET_PRB_POLICY_RATIO_CCC",
      "stage": "v4",
      "description": "Future E2SM-CCC PRB policy action."
    },
    {
      "type": "SET_PRB_POLICY_RATIO_RC_DU",
      "stage": "v4",
      "description": "Future E2SM-RC DU PRB policy action."
    }
  ]
}
