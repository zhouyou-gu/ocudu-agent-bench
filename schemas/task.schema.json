{
  "type": "object",
  "required": ["id", "version", "G", "E", "U", "I", "J", "M"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*_v[0-9]+$"},
    "version": {"type": "integer", "minimum": 1},
    "G": {"type": "string", "minLength": 1},
    "E": {
      "type": "object",
      "required": ["runtime_adapter", "runtime", "components"],
      "properties": {
        "runtime_adapter": {"type": "string"},
        "runtime": {"type": "string"},
        "components": {"type": "array", "items": {"type": "string"}}
      }
    },
    "U": {"$ref": "stimulus.schema.json"},
    "I": {
      "type": "object",
      "required": ["api_kinds", "allowed_actions", "observation_sources", "allow_no_action"],
      "properties": {
        "api_kinds": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "observation_sources": {"type": "array", "items": {"type": "string"}},
        "allow_no_action": {"type": "boolean"},
        "observation_detail": {"type": "string", "enum": ["repair_targets", "diagnosis_symptoms"]}
      }
    },
    "J": {
      "type": "object",
      "properties": {
        "scoring_rule": {"type": "string"},
        "raw_metrics": {"type": "array", "items": {"type": "string"}},
        "critical_metrics": {"type": "array", "items": {"type": "string"}},
        "temporal_expectations": {"type": "array", "items": {"type": "object"}},
        "expected_action_fields": {"type": "array", "items": {"type": "object"}},
        "expected_post_action_evidence": {"type": "array", "items": {"type": "object"}}
      }
    },
    "M": {
      "type": "object",
      "required": ["task_set", "family", "role"],
      "properties": {
        "task_set": {"type": "string", "enum": ["base", "regression", "compound", "generated"]},
        "family": {"type": "string", "enum": ["prb", "ssb", "mobility", "radio_cli", "core", "diagnosis", "isolation", "restraint", "backend", "harness"]},
        "role": {"type": "string", "enum": ["primary", "regression", "compound"]},
        "variant": {
          "type": "object",
          "required": ["family", "axis", "level", "anchor_task_id", "suite", "variant_id", "seed", "axis_values", "expected_failure_modes"],
          "properties": {
            "family": {"type": "string"},
            "axis": {"type": "string"},
            "level": {"type": "string"},
            "anchor_task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*_v[0-9]+$"},
            "suite": {"type": "string"},
            "variant_id": {"type": "string"},
            "seed": {"type": "integer"},
            "axis_values": {"type": "object"},
            "expected_failure_modes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        }
      }
    },
    "allowed_observation_context": {"type": "array", "items": {"type": "string"}},
    "public_constraints": {"type": "array", "items": {"type": "string"}}
  }
}
