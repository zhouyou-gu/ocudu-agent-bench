{
  "id": "compound_diagnosis_coverage_vs_backhaul_v1",
  "version": 1,
  "G": "Infer from symptoms that the latent cause is coverage rather than backhaul, then apply SSB control once.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 3,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "pre_observation",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "in_step",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "slice_demand_shift",
        "phase": "pre_observation",
        "parameters": {
          "sst": 1,
          "demand_level": "nominal",
          "active_ues": 1,
          "min_prb_policy_ratio": 20,
          "max_prb_policy_ratio": 80
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "coverage_edge",
          "sinr_db": 3.5,
          "cqi": 2,
          "target_ssb_block_power_dbm": -12
        },
        "start_step": 2,
        "end_step": 3
      },
      {
        "kind": "radio_condition_profile",
        "phase": "in_step",
        "parameters": {
          "profile": "coverage_edge",
          "sinr_db": 3.5,
          "cqi": 2,
          "target_ssb_block_power_dbm": -12
        },
        "start_step": 2,
        "end_step": 3
      },
      {
        "kind": "backhaul_impairment",
        "phase": "pre_observation",
        "parameters": {
          "delay_ms": 2.0,
          "loss_rate": 0.0,
          "throughput_mbps": 900.0
        },
        "start_step": 1,
        "end_step": 3
      }
    ]
  },
  "I": {
    "api_kinds": [
      "ocudu_websocket_prb_policy",
      "ocudu_websocket_ssb_power",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "SET_PRB_POLICY_RATIO_WS",
      "SET_SSB_BLOCK_POWER_WS"
    ],
    "observation_sources": [
      "ping",
      "json_metrics",
      "cell_identity",
      "radio_runtime",
      "backhaul_runtime",
      "websocket_control_outcomes"
    ],
    "allow_no_action": true,
    "observation_detail": "diagnosis_symptoms"
  },
  "J": {
    "scoring_rule": "latent_coverage_vs_backhaul",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "correct_api_selection",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown",
      "action_timing_similarity",
      "expected_action_payload_similarity",
      "post_action_evidence_similarity"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "correct_api_selection",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "oracle_requirements": [
      "slice_runtime",
      "radio_runtime",
      "control_outcome"
    ],
    "expected_action_type": "SET_SSB_BLOCK_POWER_WS",
    "max_actions": 1,
    "require_evidence_before_action": true,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 2,
        "action_type": "SET_SSB_BLOCK_POWER_WS"
      },
      {
        "step_id": 3,
        "action_type": "NO_ACTION"
      }
    ],
    "expected_action_fields": [
      {
        "step_id": 2,
        "action_type": "SET_SSB_BLOCK_POWER_WS",
        "fields": {
          "nci": 6733824,
          "ssb_block_power_dbm": -16
        }
      }
    ],
    "expected_post_action_evidence": [
      {
        "after_step_id": 2,
        "step_id": 3,
        "fields": {
          "radio_runtime.current_ssb_block_power_dbm": -16,
          "radio_runtime.ssb_power_cell.nci": 6733824
        }
      }
    ]
  },
  "allowed_observation_context": [
    "task_id",
    "step_id",
    "backend"
  ],
  "public_constraints": [
    "Use only task-selected APIs and avoid repeated control after accepted repair."
  ],
  "M": {
    "task_set": "compound",
    "family": "diagnosis",
    "role": "compound"
  }
}
