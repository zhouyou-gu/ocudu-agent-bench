{
  "id": "compound_grid3_coverage_cqi_b_v1",
  "version": 1,
  "G": "Infer that coverage is degrading although the SINR reads good, then apply one SSB power fix.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "ocudu_cli",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 4,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 4
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "pre_observation",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 4
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "in_step",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 4
      },
      {
        "kind": "backhaul_impairment",
        "phase": "pre_observation",
        "parameters": {
          "delay_ms": 2.0,
          "loss_rate": 0.0,
          "throughput_mbps": 900.0
        },
        "start_step": 1,
        "end_step": 4
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "coverage_edge",
          "sinr_db": 20.5,
          "cqi": 3,
          "target_ssb_block_power_dbm": -11
        },
        "start_step": 3,
        "end_step": 4
      }
    ]
  },
  "I": {
    "api_kinds": [
      "ocudu_websocket_prb_policy",
      "ocudu_websocket_ssb_power",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "SET_PRB_POLICY_RATIO_WS",
      "SET_SSB_BLOCK_POWER_WS"
    ],
    "observation_sources": [
      "ping",
      "json_metrics",
      "backhaul_runtime",
      "radio_runtime",
      "slice_runtime",
      "websocket_control_outcomes"
    ],
    "allow_no_action": true,
    "observation_detail": "diagnosis_symptoms"
  },
  "J": {
    "scoring_rule": "latent_congestion_vs_coverage",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "valid_action_accepted_rate",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "valid_action_accepted_rate",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 2,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 3,
        "action_type": "SET_SSB_BLOCK_POWER_WS"
      },
      {
        "step_id": 4,
        "action_type": "NO_ACTION"
      }
    ]
  },
  "M": {
    "task_set": "compound",
    "family": "diagnosis",
    "role": "compound"
  }
}
