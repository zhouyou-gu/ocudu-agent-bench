{
  "id": "compound_grid_mob_cond_four_edge_v1",
  "version": 1,
  "G": "Choose the handover procedure the visible mobility state requires (4 target cells), then trigger it once.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "ocudu_cli",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 3,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "pre_observation",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "in_step",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "mobility_path",
        "phase": "pre_observation",
        "parameters": {
          "serving_pci": 38,
          "target_pcis": [
            91,
            95,
            99,
            103
          ],
          "rnti": "0x4601",
          "du_ue_id": 1
        },
        "apply_steps": [
          2
        ]
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "coverage_edge",
          "sinr_db": 6.0,
          "cqi": 4,
          "rsrp_dbm": -109.0,
          "rsrq_db": -16.0
        },
        "apply_steps": [
          2
        ]
      }
    ]
  },
  "I": {
    "api_kinds": [
      "ocudu_cli_handover",
      "ocudu_cli_conditional_handover",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "TRIGGER_HANDOVER_CLI",
      "TRIGGER_CONDITIONAL_HANDOVER_CLI"
    ],
    "observation_sources": [
      "ping",
      "json_metrics",
      "ue_identity",
      "cell_identity",
      "radio_runtime",
      "websocket_control_outcomes"
    ],
    "allow_no_action": true,
    "observation_detail": "diagnosis_symptoms"
  },
  "J": {
    "scoring_rule": "latent_congestion_vs_coverage",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "valid_action_accepted_rate",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "valid_action_accepted_rate",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "oracle_requirements": [
      "ue_identity",
      "radio_runtime"
    ],
    "expected_action_type": "TRIGGER_CONDITIONAL_HANDOVER_CLI",
    "max_actions": 1,
    "require_evidence_before_action": true,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 2,
        "action_type": "TRIGGER_CONDITIONAL_HANDOVER_CLI"
      },
      {
        "step_id": 3,
        "action_type": "NO_ACTION"
      }
    ]
  },
  "allowed_observation_context": [
    "task_id",
    "step_id",
    "backend"
  ],
  "public_constraints": [
    "Use only task-selected APIs and avoid repeated control after accepted repair."
  ],
  "M": {
    "task_set": "compound",
    "family": "mobility",
    "role": "compound"
  }
}