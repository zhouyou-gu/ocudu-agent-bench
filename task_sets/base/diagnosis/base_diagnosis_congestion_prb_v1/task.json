{
  "id": "base_diagnosis_congestion_prb_v1",
  "version": 1,
  "G": "Diagnose congestion evidence as a PRB-policy problem rather than a coverage problem.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 3,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "pre_observation",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "in_step",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "nominal",
          "sinr_db": 21.0,
          "cqi": 12
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "slice_demand_shift",
        "phase": "pre_observation",
        "parameters": {
          "sst": 1,
          "demand_level": "high",
          "active_ues": 8,
          "min_prb_policy_ratio": 25,
          "max_prb_policy_ratio": 85
        },
        "start_step": 2,
        "end_step": 3
      },
      {
        "kind": "traffic_load_profile",
        "phase": "in_step",
        "parameters": {
          "profile": "high",
          "packet_rate_pps": 900.0,
          "active_ues": 8
        },
        "start_step": 2,
        "end_step": 3
      }
    ]
  },
  "I": {
    "api_kinds": [
      "ocudu_websocket_prb_policy",
      "ocudu_websocket_ssb_power",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "SET_PRB_POLICY_RATIO_WS",
      "SET_SSB_BLOCK_POWER_WS"
    ],
    "observation_sources": [
      "ping",
      "json_metrics",
      "slice_runtime",
      "radio_runtime",
      "websocket_control_outcomes"
    ],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "diagnose_congestion_prb",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "correct_api_selection",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "correct_api_selection",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "oracle_requirements": [
      "slice_runtime",
      "radio_runtime",
      "control_outcome"
    ],
    "expected_action_type": "SET_PRB_POLICY_RATIO_WS",
    "max_actions": 1,
    "require_evidence_before_action": true,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 2,
        "action_type": "SET_PRB_POLICY_RATIO_WS"
      },
      {
        "step_id": 3,
        "action_type": "NO_ACTION"
      }
    ],
    "expected_action_fields": [
      {
        "step_id": 2,
        "action_type": "SET_PRB_POLICY_RATIO_WS",
        "fields": {
          "min_prb_policy_ratio": 25,
          "max_prb_policy_ratio": 85
        }
      }
    ],
    "expected_post_action_evidence": [
      {
        "after_step_id": 2,
        "step_id": 3,
        "fields": {
          "slice_runtime.current_prb_policy.min_prb_policy_ratio": 25,
          "slice_runtime.current_prb_policy.max_prb_policy_ratio": 85,
          "slice_runtime.current_prb_policy.backend": "websocket",
          "slice_runtime.current_prb_policy.action_type": "SET_PRB_POLICY_RATIO_WS"
        }
      }
    ]
  },
  "allowed_observation_context": [
    "task_id",
    "step_id",
    "backend"
  ],
  "public_constraints": [
    "Use only task-selected APIs and avoid repeated control after accepted repair."
  ],
  "M": {
    "task_set": "base",
    "family": "diagnosis",
    "role": "primary"
  }
}
