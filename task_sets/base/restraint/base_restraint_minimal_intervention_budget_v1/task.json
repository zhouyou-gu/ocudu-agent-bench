{
  "id": "base_restraint_minimal_intervention_budget_v1",
  "version": 1,
  "G": "Avoid RAN over-control during healthy and mild transient evidence.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 3,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "pre_observation",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "ue_ping_traffic",
        "phase": "in_step",
        "parameters": {
          "packets": 3
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "slice_demand_shift",
        "phase": "pre_observation",
        "parameters": {
          "sst": 1,
          "demand_level": "nominal",
          "active_ues": 1,
          "min_prb_policy_ratio": 20,
          "max_prb_policy_ratio": 80
        },
        "start_step": 1,
        "end_step": 3
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "mild_transient",
          "sinr_db": 16.0,
          "cqi": 8
        },
        "apply_steps": [
          2
        ]
      },
      {
        "kind": "radio_condition_profile",
        "phase": "pre_observation",
        "parameters": {
          "profile": "nominal",
          "sinr_db": 21.0,
          "cqi": 12
        },
        "apply_steps": [
          1,
          3
        ]
      }
    ]
  },
  "I": {
    "api_kinds": [
      "ocudu_websocket_prb_policy",
      "ocudu_websocket_ssb_power",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "SET_PRB_POLICY_RATIO_WS",
      "SET_SSB_BLOCK_POWER_WS"
    ],
    "observation_sources": [
      "ping",
      "json_metrics",
      "radio_runtime",
      "slice_runtime",
      "websocket_control_outcomes"
    ],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "minimal_intervention_budget",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "noop_correctness",
      "unnecessary_action_avoidance",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "noop_correctness",
      "unnecessary_action_avoidance",
      "action_budget_ok",
      "ping_success_ratio",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "oracle_requirements": [
      "radio_runtime",
      "slice_runtime"
    ],
    "max_actions": 0,
    "require_no_action": true,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 2,
        "action_type": "NO_ACTION"
      },
      {
        "step_id": 3,
        "action_type": "NO_ACTION"
      }
    ]
  },
  "allowed_observation_context": [
    "task_id",
    "step_id",
    "backend"
  ],
  "public_constraints": [
    "Do not act on healthy or mild transient evidence."
  ],
  "M": {
    "task_set": "base",
    "family": "restraint",
    "role": "primary"
  }
}
