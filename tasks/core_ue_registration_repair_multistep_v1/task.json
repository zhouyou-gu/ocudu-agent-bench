{
  "id": "core_ue_registration_repair_multistep_v1",
  "version": 1,
  "G": "Repair a visible benchmark-owned core UE-registration mismatch once, then avoid repeating it.",
  "E": {
    "runtime_adapter": "simulated_ocudu",
    "runtime": "ocudu_zmq_open5gs",
    "components": [
      "ocudu_websocket",
      "open5gs",
      "srsue_zmq"
    ]
  },
  "U": {
    "steps": 2,
    "timing_policy": {
      "clock_mode": "fixed_tick",
      "step_interval_s": 0.01,
      "decision_deadline_s": 0.01
    },
    "events": [
      {
        "kind": "docker_zmq_runtime_launch",
        "phase": "pre_observation",
        "parameters": {},
        "apply_steps": [
          1
        ]
      },
      {
        "kind": "metrics_staleness_mask",
        "phase": "pre_observation",
        "parameters": {
          "stale_until_step": 0
        },
        "start_step": 1,
        "end_step": 2
      },
      {
        "kind": "core_ue_registration_misconfig",
        "phase": "pre_observation",
        "parameters": {
          "mismatch_field": "supi",
          "mismatch_value": "001010000000099"
        },
        "apply_steps": [
          1
        ]
      }
    ]
  },
  "I": {
    "api_kinds": [
      "core_ue_registration_control",
      "ocudu_json_metrics"
    ],
    "allowed_actions": [
      "UPDATE_CORE_UE_REGISTRATION"
    ],
    "observation_sources": [
      "json_metrics",
      "core_runtime"
    ],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "core_ue_registration_repair_multistep",
    "raw_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "core_ue_registration_repaired",
      "action_budget_ok",
      "metrics_continuity",
      "clean_teardown"
    ],
    "critical_metrics": [
      "temporal_action_sequence_match",
      "expected_action_payload_match",
      "post_action_evidence_match",
      "valid_action_accepted_rate",
      "core_ue_registration_repaired",
      "action_budget_ok",
      "metrics_continuity",
      "clean_teardown"
    ],
    "success_threshold": 1.0,
    "oracle_requirements": [
      "core_runtime",
      "control_outcome"
    ],
    "expected_action_type": "UPDATE_CORE_UE_REGISTRATION",
    "max_actions": 1,
    "require_evidence_before_action": true,
    "temporal_expectations": [
      {
        "step_id": 1,
        "action_type": "UPDATE_CORE_UE_REGISTRATION"
      },
      {
        "step_id": 2,
        "action_type": "NO_ACTION"
      }
    ],
    "expected_action_fields": [
      {
        "step_id": 1,
        "action_type": "UPDATE_CORE_UE_REGISTRATION",
        "fields": {
          "ue_id": "ue1",
          "supi": "001010000000001",
          "plmn": "00101",
          "dnn": "internet",
          "sst": 1,
          "sd": null,
          "auth_profile_id": "ue1_test_profile"
        }
      }
    ],
    "expected_post_action_evidence": [
      {
        "after_step_id": 1,
        "step_id": 2,
        "fields": {
          "core_runtime.ue_registration.status": "registered",
          "core_runtime.ue_registration.current.supi": "001010000000001"
        }
      }
    ]
  },
  "allowed_observation_context": [
    "task_id",
    "step_id",
    "backend"
  ],
  "public_constraints": [
    "Use only task-selected APIs and avoid repeated control after accepted repair."
  ]
}
