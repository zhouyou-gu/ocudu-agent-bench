{
  "id": "ran_policy_triage_v1",
  "version": 1,
  "G": "Diagnose the visible RAN evidence and select the minimum safe RAN API action or no-action.",
  "E": {"runtime_adapter": "simulated_ocudu", "runtime": "ocudu_zmq_open5gs_flexric", "components": ["ocudu_websocket", "open5gs", "srsue_zmq", "flexric"]},
  "U": {
    "steps": 2,
    "timing_policy": {"clock_mode": "fixed_tick", "step_interval_s": 1.0, "decision_deadline_s": 1.0},
    "events": [
      {"kind": "docker_zmq_runtime_launch", "phase": "pre_observation", "parameters": {}},
      {"kind": "ue_ping_traffic", "phase": "pre_observation", "parameters": {"packets": 3}},
      {"kind": "metrics_staleness_mask", "phase": "pre_observation", "parameters": {"stale_until_step": 0}},
      {"kind": "ue_ping_traffic", "phase": "in_step", "parameters": {"packets": 3}}
    ]
  },
  "I": {
    "api_kinds": ["ocudu_websocket_prb_policy", "ocudu_websocket_ssb_power", "ocudu_json_metrics", "e2sm_kpm_v05_observation", "e2sm_ccc_prb_policy_control", "e2sm_rc_du_prb_quota_control"],
    "allowed_actions": ["SET_PRB_POLICY_RATIO_WS", "SET_SSB_BLOCK_POWER_WS", "SET_PRB_POLICY_RATIO_CCC", "SET_PRB_POLICY_RATIO_RC_DU"],
    "observation_sources": ["ping", "json_metrics", "websocket_control_outcomes", "cell_identity", "e2_kpm_v05", "e2_control_outcome", "ue_identity"],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "policy_triage",
    "max_actions": 1,
    "raw_metrics": ["triage_success", "correct_api_selection", "unnecessary_action_avoidance", "repair_success", "ping_success_ratio", "metrics_continuity", "clean_teardown"],
    "critical_metrics": ["triage_success", "ping_success_ratio", "metrics_continuity", "clean_teardown"],
    "success_threshold": 1.0,
    "oracle_requirements": ["control_outcome", "ping", "metrics", "e2"]
  },
  "allowed_observation_context": ["task_id", "step_id", "backend"],
  "public_constraints": ["Select the minimum safe task-selected API action."]
}
