{
  "id": "e2_kpm_json_consistency_v1",
  "version": 1,
  "G": "Use both JSON metrics and E2SM-KPM evidence before applying one PRB action.",
  "E": {"runtime_adapter": "simulated_ocudu", "runtime": "ocudu_zmq_open5gs_flexric", "components": ["ocudu_websocket", "open5gs", "srsue_zmq", "flexric"]},
  "U": {
    "steps": 2,
    "timing_policy": {"clock_mode": "fixed_tick", "step_interval_s": 1.0, "decision_deadline_s": 1.0},
    "events": [
      {"kind": "docker_zmq_runtime_launch", "phase": "pre_observation", "parameters": {}},
      {"kind": "ue_ping_traffic", "phase": "pre_observation", "parameters": {"packets": 3}},
      {"kind": "metrics_staleness_mask", "phase": "pre_observation", "parameters": {"stale_until_step": 0}},
      {"kind": "ue_ping_traffic", "phase": "in_step", "parameters": {"packets": 3}}
    ]
  },
  "I": {
    "api_kinds": ["ocudu_websocket_prb_policy", "ocudu_json_metrics", "e2sm_kpm_v05_observation"],
    "allowed_actions": ["SET_PRB_POLICY_RATIO_WS"],
    "observation_sources": ["ping", "json_metrics", "e2_kpm_v05", "websocket_control_outcomes"],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "json_and_e2_consistency",
    "expected_action_type": "SET_PRB_POLICY_RATIO_WS",
    "max_actions": 1,
    "require_evidence_before_action": true,
    "raw_metrics": ["evidence_gated_action", "valid_action_accepted_rate", "metrics_continuity", "e2_kpm_continuity", "clean_teardown"],
    "critical_metrics": ["evidence_gated_action", "valid_action_accepted_rate", "metrics_continuity", "e2_kpm_continuity", "clean_teardown"],
    "success_threshold": 1.0,
    "oracle_requirements": ["metrics", "e2_kpm"]
  },
  "allowed_observation_context": ["task_id", "step_id", "backend"],
  "public_constraints": ["Treat JSON metrics and E2 evidence as separate evidence sources."]
}
