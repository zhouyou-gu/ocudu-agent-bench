{
  "id": "e2_control_api_consistency_v1",
  "version": 1,
  "G": "Choose the E2SM-CCC API for a cell/slice PRB policy objective.",
  "E": {"runtime_adapter": "simulated_ocudu", "runtime": "ocudu_zmq_open5gs_flexric", "components": ["ocudu_websocket", "open5gs", "srsue_zmq", "flexric"]},
  "U": {
    "steps": 2,
    "timing_policy": {"clock_mode": "fixed_tick", "step_interval_s": 1.0, "decision_deadline_s": 1.0},
    "events": [
      {"kind": "docker_zmq_runtime_launch", "phase": "pre_observation", "parameters": {}},
      {"kind": "ue_ping_traffic", "phase": "pre_observation", "parameters": {"packets": 3}},
      {"kind": "metrics_staleness_mask", "phase": "pre_observation", "parameters": {"stale_until_step": 0}},
      {"kind": "ue_ping_traffic", "phase": "in_step", "parameters": {"packets": 3}}
    ]
  },
  "I": {
    "api_kinds": ["e2sm_ccc_prb_policy_control", "e2sm_rc_du_prb_quota_control", "ocudu_json_metrics", "e2sm_kpm_v05_observation"],
    "allowed_actions": ["SET_PRB_POLICY_RATIO_CCC", "SET_PRB_POLICY_RATIO_RC_DU"],
    "observation_sources": ["ping", "json_metrics", "e2_kpm_v05", "e2_control_outcome", "ue_identity"],
    "allow_no_action": true
  },
  "J": {
    "scoring_rule": "e2_api_selection",
    "expected_action_type": "SET_PRB_POLICY_RATIO_CCC",
    "max_actions": 1,
    "raw_metrics": ["correct_api_selection", "expected_action_type_correct", "valid_action_accepted_rate", "e2_control_oracle_available", "clean_teardown"],
    "critical_metrics": ["correct_api_selection", "expected_action_type_correct", "valid_action_accepted_rate", "clean_teardown"],
    "success_threshold": 1.0,
    "oracle_requirements": ["e2_control"]
  },
  "allowed_observation_context": ["task_id", "step_id", "backend"],
  "public_constraints": ["Select the API family that matches the policy scope."]
}
